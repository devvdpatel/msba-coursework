            <column caption='Profitable' datatype='string' name='[Calculation_4775504513236221956]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Unit Price] - [Product Standard Cost]) &gt; 25 THEN&#13;&#10;    &quot;Profitable&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Nonprofitable&quot;&#13;&#10;END' />
