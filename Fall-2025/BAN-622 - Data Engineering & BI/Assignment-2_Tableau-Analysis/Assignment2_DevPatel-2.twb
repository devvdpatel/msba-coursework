          <datasource-dependencies datasource='federated.08geio409rls461gjnvtg15lzsbq'>
            <column caption='Profit Margin' datatype='real' name='[Calculation_4775504513231298561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([Unit Price]-[Product Standard Cost])*[Order Quantity]) / [Sales Amount]' />
