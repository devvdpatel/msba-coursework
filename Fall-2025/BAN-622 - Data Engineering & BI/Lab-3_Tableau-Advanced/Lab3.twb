      <aliases enabled='yes' />
      <column caption='Date Difference' datatype='integer' name='[Calculation_2588443942588137472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [End Date], [Start Date])' />
      </column>
      <column caption='Profit Evaluation' datatype='string' name='[Calculation_2588443942594715651]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if avg([Unit Price]) &gt; 150 THEN &apos;Profitable&apos; + MIN([Product Line])&#13;&#10;ELSE &apos;Non Profitable&apos; + MIN([Product Line])&#13;&#10;END' />
      </column>
      <column caption='Unit Profit ' datatype='real' name='[Calculation_5104267284415660033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Unit Price]-[Product Standard Cost]' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_5104267284416053250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5104267284415660033]*[Order Quantity]' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_5104267284416344068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5104267284416053250]/[Sales Amount]' />
      </column>
      <column caption='Overall Average Profit' datatype='real' name='[Calculation_5104267284416454661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_5104267284416053250])/AVG([Sales Amount])' />
      </column>
      <column caption='Customer Full Name' datatype='string' name='[Calculation_5104267284423811078]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[First Name]+&quot;, &quot;+ [Middle Name]+ &quot;, &quot; + [Last Name]' />
      </column>
      <column caption='Customer Name and Income' datatype='string' name='[Calculation_5104267284424884231]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5104267284423811078] + &quot;, &quot; + STR([Yearly Income])' />
      </column>
